# Copy to .env and fill in real values. .env is gitignored.

# JSON-RPC endpoint of the local geth node
CHAIN_RPC_URL=http://127.0.0.1:8545

# Path to the Truffle project (contains contractAddr.json and build/contracts/*.json)
TRUFFLE_PROJECT_DIR=truffleProject

# Path to the account password file (one password per line, matches address.txt order)
PASSWORD_FILE=password.txt

# Directory containing geth keystore files
KEYSTORE_DIR=data/keystore

# Raw private key used by scripts/run_demo.py to sign the double-spend transactions.
# Generate a throwaway key for the local test chain only - never a real-funds key.
DOUBLE_SPEND_PRIVATE_KEY=0xyourprivatekeyhere
